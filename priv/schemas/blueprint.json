{
  "$id": "schemas/blueprint",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Blueprint Definition",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-z0-9._-]+$"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[A-z0-9._-]+$"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "schemas/blueprint/task"
      }
    },
    "env": {
      "type": "object",
      "$ref": "schemas/blueprint/env"
    },
    "inputs": {
      "type": "object",
      "$ref": "schemas/blueprint/inputs"
    },
    "outputs": {
      "type": "object",
      "$ref": "schemas/blueprint/outputs"
    },
    "triggers": {
      "type": "object",
      "$ref": "schemas/blueprint/triggers"
    }
  },
  "required": [
    "id",
    "namespace",
    "tasks"
  ]
}
