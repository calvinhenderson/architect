{
  "$id": "schemas/blueprint",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Blueprint Definition",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-z0-9._-]+$"
    },
    "retries": {
      "$ref": "schemas/blueprint/retries"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "schemas/blueprint/step"
      }
    },
    "env": {
      "$ref": "schemas/blueprint/env"
    },
    "inputs": {
      "$ref": "schemas/blueprint/inputs"
    },
    "outputs": {
      "type": "object"
    },
    "triggers": {
      "$ref": "schemas/blueprint/triggers"
    }
  },
  "required": [
    "id",
    "namespace",
    "steps"
  ]
}
