{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/blueprint/triggers",
  "title": "Blueprint triggers",
  "description": "Describes external triggers for a blueprint",
  "type": "array",
  "items": {
    "type": "object",
    "allOf": [
      {
        "if": {
          "properties": {
            "type": {
              "const": "duration"
            }
          }
        },
        "then": {
          "properties": {
            "duration": {
              "$ref": "schemas/duration"
            }
          }
        }
      }
    ]
  }
}
